# Copy to .env and fill in. Only the providers you actually use are required.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenRouter — one key for Gemini, Grok, DeepSeek, Qwen, Llama, etc.
OPENROUTER_API_KEY=

# For unattended cloud runs (scripts/runpod_*.sh): a GitHub PAT with repo write,
# so the pod can push generated results back to a branch.
# GITHUB_TOKEN=

# Optional: path to a SoundFont for audio rendering (see scripts/setup_soundfont.sh).
# If unset, the pipeline looks in ./soundfonts/ and falls back to skipping audio.
# SOUNDFONT_PATH=

# Composer studio (see STUDIO.md). Password is required to start the server;
# pin STUDIO_SECRET so login cookies survive restarts. On RunPod, set
# STUDIO_BACKUP_REPO (private git remote, https URL with token) — pod volumes
# don't survive termination.
# STUDIO_PASSWORD=
# STUDIO_SECRET=
# STUDIO_DEFAULT_MODEL=opus-4.8
# STUDIO_NOTIFY_URL=
# STUDIO_BACKUP_REPO=
# Spending brake: max generations per window across all sessions (a chat
# message = 1, a comparison round = 1 per cell). Defaults: 100 per 900s.
# STUDIO_RATE_LIMIT=100
# STUDIO_RATE_WINDOW=900
